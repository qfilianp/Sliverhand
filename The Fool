<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Filly's SWF Player (offline)</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text x='50' y='80' font-size='80' text-anchor='middle' dominant-baseline='middle'>🍇</text></svg>">
    <style>
        body { background: #222; color: #fff; font-family: sans-serif; text-align: center; padding-top: 30px; }
        #controls { margin: 20px auto; }
        #player-container { width: 800px; height: 600px; margin: 20px auto; background: #000; border: 2px solid #444; }
        #player-container.fullscreen { width: 100vw; height: 100vh; margin: 0; border: none; }
        button { background: #444; color: #fff; border: 1px solid #666; padding: 8px 16px; cursor: pointer; margin: 5px; border-radius: 4px; }
        button:hover { background: #555; }
    </style>
</head>
<body>

    <h1>Ruffle SWF Player (offline)</h1>
    <div id="controls">
        <p>Select your <strong>SWF</strong> file:</p>
        <input type="file" id="swf-file" accept=".swf">
        <button id="fullscreen-btn">Fullscreen</button>
    </div>
    
    <div id="player-container"></div>

    <!-- Fetch shim: returns the embedded wasm when Ruffle requests ruffle.wasm -->
    <script>
    // Replace __RUFFLE_WASM_BASE64_PLACEHOLDER__ with the single-line base64 of ruffle.wasm
    const RUFFLE_WASM_BASE64 = "__RUFFLE_WASM_BASE64_PLACEHOLDER__";

    (function installWasmFetchShim() {
        const originalFetch = window.fetch.bind(window);
        window.fetch = function(input, init) {
            try {
                const url = (typeof input === 'string') ? input : (input && input.url) || '';
                if (url && url.indexOf('ruffle.wasm') !== -1) {
                    // decode base64 -> ArrayBuffer
                    const binary = atob(RUFFLE_WASM_BASE64);
                    const len = binary.length;
                    const bytes = new Uint8Array(len);
                    for (let i = 0; i < len; i++) bytes[i] = binary.charCodeAt(i);
                    const resp = new Response(bytes, { headers: { 'Content-Type': 'application/wasm' } });
                    return Promise.resolve(resp);
                }
            } catch (err) {
                console.error('WASM shim error', err);
            }
            return originalFetch(input, init);
        };
    })();
    </script>

    <!-- Inline Ruffle JS: replace the comment below with the full contents of ruffle.js.
         IMPORTANT: if you paste raw JS into here inside <script>...</script>, make sure any
         literal "</script>" sequences in the JS are escaped as "<\/script>" so the HTML parser
         doesn't prematurely end the script tag. -->
    <script>
    /*__RUFFLE_JS_PLACEHOLDER__*/
    </script>

    <script>
        let isFullscreen = false;

        document.getElementById('swf-file').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (!file) return;

            const fileURL = URL.createObjectURL(file);
            const container = document.getElementById('player-container');
            container.innerHTML = ''; // Clear previous player

            const ruffle = window.RufflePlayer.newest();
            const player = ruffle.createPlayer();
            player.style.width = '100%';
            player.style.height = '100%';
            container.appendChild(player);

            player.load({
                url: fileURL,
                backgroundColor: '#000',
                autoplay: 'on'
            });
        });

        document.getElementById('fullscreen-btn').addEventListener('click', function() {
            const container = document.getElementById('player-container');
            const controls = document.getElementById('controls');
            
            if (!isFullscreen) {
                container.classList.add('fullscreen');
                controls.style.display = 'none';
                isFullscreen = true;
                this.textContent = 'Exit Fullscreen';
                if (container.requestFullscreen) container.requestFullscreen().catch(err => console.log(err));
            } else {
                container.classList.remove('fullscreen');
                controls.style.display = 'block';
                isFullscreen = false;
                this.textContent = 'Fullscreen';
                if (document.fullscreenElement) document.exitFullscreen();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && isFullscreen) {
                document.getElementById('fullscreen-btn').click();
            }
        });
    </script>
</body>
</html>
</html>
